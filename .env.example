# --- LLM / Embedding ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
LLM_HQ_MODEL=gpt-4o-mini
LLM_QUERY_REWRITE_MODEL=gpt-4o-mini
LLM_ANSWER_MODEL=gpt-4o

# --- PubMed ---
PUBMED_EMAIL=jan@activesearch.ai
PUBMED_API_KEY=
PUBMED_DOMAIN=cardiology
PUBMED_CORPUS_SIZE=1000

# --- Vector DB (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=ezmed_chunks

# --- SQL (Postgres) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ezmed
POSTGRES_USER=ezmed
POSTGRES_PASSWORD=ezmed

# --- Langfuse (optional tracking) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
HQ_PER_CHUNK=4

# --- App ---
LOG_LEVEL=INFO
DATA_DIR=./data
